[[0.056, 0.72, "Até aqui..."], [1.096, 4.272, "O celular do número do recibo tocou dentro da mochila do Creisson."], [4.52, 6.32, "O amigo de confiança era o traidor."], [6.584, 7.496, "E, bem nessa hora,"], [7.648, 8.808, "o Tibúrcio entrou no bar."], [12.4, 14.064, "Tu tem alguma coisa pra me entregar, menino?"], [14.392, 16.16, "O Creisson tira o celular da mochila."], [16.36, 17.104, "As mãos tremem."], [17.304, 18.032, "E, finalmente..."], [18.184, 18.656, "ele fala."], [19.032, 19.408, "Fui eu."], [19.72, 21.2, "Eu e a Jéssica armamos o barco."], [21.464, 22.384, "Eu fiquei com o dinheiro."], [22.72, 24.152, "Cansei de ser o menino do grupo."], [24.384, 25.616, "Eu queria sair desse lugar."], [25.992, 26.984, "E a foto da Keliane?"], [27.168, 27.8, "Foi tu também?"], [28.152, 28.464, "Fui."], [28.744, 30.632, "Enquanto vocês brigavam por causa dela..."], [30.88, 31.816, "ninguém olhava pra mim."], [32.176, 34.264, "Do fundo da mochila, ele tira um pacote."], [34.488, 35.512, "Trinta mil reais."], [35.696, 36.168, "O resto..."], [36.288, 37.264, "ele já tinha gastado."], [37.624, 38.28, "Faltam dez."], [38.664, 39.144, "Silêncio."], [39.368, 41.648, "Aí, o Juvenal coloca um envelope no balcão."], [42.016, 42.496, "Dez mil."], [42.744, 43.952, "Era o dinheiro do meu casamento."], [44.264, 45.232, "Não vai precisar mais."], [45.616, 46.064, "Juva..."], [46.384, 47.6, "eu não sei nem o que dizer."], [47.952, 48.664, "Dívida paga."], [49.032, 50.296, "Agora tu vem comigo, Creisson."], [50.496, 52.192, "Os credores querem conversar contigo."], [52.544, 54.24, "E o Creisson sai do Bar do Sandro."], [54.464, 55.44, "Sem olhar pra trás."], [55.84, 59.08, "No dia seguinte, a Keliane espera o Juvenal na porta da oficina."], [59.36, 59.864, "Juva..."], [60.104, 61.24, "a gente pode conversar?"], [61.52, 62.352, "Hoje não, Keliane."], [62.712, 64.376, "A Raimundinha abraça o Juvenal."], [64.576, 67.472, "O Sandro e a Marilene, pela primeira vez, brindam juntos."], [67.656, 68.352, "E o Cleitinho..."], [68.504, 71.04, "promete nunca mais pegar um real emprestado."], [71.368, 72.104, "Mas no porto,"], [72.232, 73.76, "o barco de Santarém tá saindo."], [73.936, 75.424, "E a Jéssica Karoline tá nele."], [75.664, 76.632, "Ela pega o celular"], [76.752, 77.504, "e liga pra alguém."], [77.8, 78.36, "Tá feito."], [78.552, 79.408, "O Creisson caiu."], [79.72, 80.416, "Do outro lado,"], [80.6, 81.416, "uma voz pergunta:"], [81.688, 82.584, "E o resto do dinheiro?"], [82.912, 83.448, "Tá comigo."], [83.64, 84.384, "Sempre esteve."], [84.736, 85.456, "No Tabocal..."], [85.68, 87.168, "todo mundo tem um segredo."], [87.528, 88.872, "Fim da primeira temporada."], [89.056, 90.84, "Curte e segue o Histórias do Tabocal,"], [90.984, 93.072, "porque a segunda temporada já tá chegando!"]]