{
  "name": "hyperframes-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "@types/node": "^22.19.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'packages/*/test/*.test.ts'",
    "typecheck": "tsc -p .",
    "hfr": "node packages/cli/bin/hfr.ts",
    "studio": "node packages/cli/bin/hfr.ts studio",
    "registry:build": "python3 packages/registry/scripts/build-items.py && python3 packages/registry/scripts/build-templates.py",
    "examples": "node packages/sdk-playground/run-all.ts"
  }
}
