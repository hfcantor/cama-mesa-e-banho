{
  "name": "bar-chart",
  "type": "block",
  "title": "Animated bar chart",
  "tags": [
    "data",
    "chart",
    "gsap"
  ],
  "description": "Bars grow with a stagger; values and labels are parameters.",
  "requires": [
    "gsap"
  ],
  "params": {
    "values": {
      "type": "string",
      "default": "42,68,55,91",
      "description": "comma-separated values"
    },
    "labels": {
      "type": "string",
      "default": "Q1,Q2,Q3,Q4",
      "description": "comma-separated labels"
    },
    "color": {
      "type": "color",
      "default": "#38bdf8",
      "description": "bar colour"
    },
    "title": {
      "type": "string",
      "default": "Revenue growth",
      "description": "chart title"
    },
    "start": {
      "type": "number",
      "default": 0,
      "description": "start (s)"
    },
    "duration": {
      "type": "number",
      "default": 5,
      "description": "duration (s)"
    }
  },
  "snippet": "snippet.html",
  "head": "head.html"
}
