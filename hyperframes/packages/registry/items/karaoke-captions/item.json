{
  "name": "karaoke-captions",
  "type": "block",
  "title": "Karaoke captions",
  "tags": [
    "captions",
    "text",
    "narration"
  ],
  "description": "Word-highlighted captions from SRT/VTT/JSON (styles: karaoke, pop, highlight, typewriter, bounce, plain).",
  "params": {
    "src": {
      "type": "string",
      "default": "captions.json",
      "description": "captions file"
    },
    "style": {
      "type": "enum",
      "default": "highlight",
      "description": "style",
      "options": [
        "karaoke",
        "pop",
        "highlight",
        "typewriter",
        "bounce",
        "plain"
      ]
    },
    "position": {
      "type": "enum",
      "default": "bottom",
      "description": "position",
      "options": [
        "top",
        "center",
        "bottom"
      ]
    },
    "size": {
      "type": "number",
      "default": 64,
      "description": "font size (px)"
    },
    "active": {
      "type": "color",
      "default": "#ffe14d",
      "description": "active word colour"
    },
    "start": {
      "type": "number",
      "default": 0,
      "description": "start (s)"
    }
  },
  "snippet": "snippet.html",
  "head": "head.html"
}
