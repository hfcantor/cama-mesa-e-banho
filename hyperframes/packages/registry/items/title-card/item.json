{
  "name": "title-card",
  "type": "block",
  "title": "Title card",
  "tags": [
    "text",
    "intro",
    "presets"
  ],
  "description": "Full-frame title + subtitle using declarative enter/exit presets (no JS).",
  "params": {
    "title": {
      "type": "string",
      "default": "Your big idea",
      "description": "title"
    },
    "subtitle": {
      "type": "string",
      "default": "A subtitle that explains it",
      "description": "subtitle"
    },
    "start": {
      "type": "number",
      "default": 0,
      "description": "start (s)"
    },
    "duration": {
      "type": "number",
      "default": 4,
      "description": "duration (s)"
    },
    "background": {
      "type": "string",
      "default": "linear-gradient(135deg,#0f172a,#312e81)",
      "description": "CSS background"
    }
  },
  "snippet": "snippet.html",
  "head": "head.html"
}
