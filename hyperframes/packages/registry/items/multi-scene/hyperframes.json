{
  "name": "{{title}}",
  "version": 1,
  "scenes": [
    {
      "src": "scenes/01-intro.html"
    },
    {
      "src": "scenes/02-middle.html",
      "transition": {
        "type": "circleopen",
        "duration": 0.8
      }
    },
    {
      "src": "scenes/03-end.html",
      "transition": {
        "type": "wave",
        "duration": 0.8
      }
    }
  ],
  "audio": [
    {
      "src": "assets/music.mp3",
      "volume": 0.6,
      "fadeOut": 1.5,
      "loop": true,
      "role": "music"
    }
  ],
  "output": {
    "file": "renders/scenes.mp4"
  }
}
