{
  "name": "counter",
  "type": "block",
  "title": "Number counter",
  "tags": [
    "data",
    "numbers"
  ],
  "description": "Counts from one number to another with easing (deterministic, via hf.onFrame).",
  "params": {
    "from": {
      "type": "number",
      "default": 0,
      "description": "start value"
    },
    "to": {
      "type": "number",
      "default": 12500,
      "description": "end value"
    },
    "prefix": {
      "type": "string",
      "default": "",
      "description": "text before"
    },
    "suffix": {
      "type": "string",
      "default": "+",
      "description": "text after"
    },
    "label": {
      "type": "string",
      "default": "happy customers",
      "description": "caption"
    },
    "locale": {
      "type": "string",
      "default": "en-US",
      "description": "number formatting locale"
    },
    "start": {
      "type": "number",
      "default": 0,
      "description": "start (s)"
    },
    "duration": {
      "type": "number",
      "default": 3,
      "description": "duration (s)"
    }
  },
  "snippet": "snippet.html",
  "head": "head.html"
}
